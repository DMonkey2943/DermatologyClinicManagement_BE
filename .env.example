# Application Settings
ENVIRONMENT=development # Environment: development, testing, production
DEBUG=True
APP_NAME=Dermatology Clinic Management App # Application name


# Database
DATABASE_URL = postgresql+psycopg2://username:password@localhost:5432/db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=dcm

# JWT
SECRET_KEY=your-super-secret-key-here
SECRET_KEY_FOR_PATIENTS=your-super-secret-key-here_patients
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS = 7

# EMAIL
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=yoursystememail@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=yoursystememail@gmail.com

# Security
# Pepper cho password hashing (thêm một lớp bảo mật)
PASSWORD_PEPPER=your-password-pepper-here